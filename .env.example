# Copy to `.env`. Read by `docker-compose.yml` only — the Rust binaries take
# their configuration from `config/*.toml` and `BEVYMMO__*` environment
# variables instead.

# The domain the stack is served from. Required by the `caddy` service, which
# gets a TLS certificate for it and for `stdb.<domain>`.
#
# It must be a domain name with DNS pointing at this host, not an IP: Let's
# Encrypt does not issue certificates for bare addresses.
SITE_DOMAIN=example.com
