/target
# The SpacetimeDB module is outside the workspace, so it has its own build
# directory that the root `/target` rule does not cover.
/crates/stdb-module/target

# Local configuration and secrets
.env
config/local.toml

# Python tooling (Blender scripts under scripts/)
__pycache__/
*.py[cod]

# Blender autosave backups. The `.blend` source is tracked; the `.blend1`
# rolling backup Blender writes next to it is not.
*.blend1
*.blend2

# Editor / exporter scratch files
*.bak
*.orig
*.rs.bk

# OS and editor cruft
.DS_Store
Thumbs.db
.claude/
.playwright-mcp/

# ChatGPT / browser downloads dumped at the repo root.
# Design sheets belong in apps/frontend/design-assets/sheets/ or assets/ui/source/.
/ChatGPT Image *.png


# Local agent/tooling scratch directories. Untracked, but noisy in
# `git status` and in anything that walks the tree — `.delta` alone reached
# 4.3 GB of checked-out worktrees.
/.delta/
/.tools/
