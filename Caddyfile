# TLS termination and the only thing exposed to the internet.
#
# Everything behind this is published on 127.0.0.1 only (see
# `docker-compose.yml`), so the plaintext ports stay reachable for local
# debugging and unreachable from outside the host. That is not decoration: the
# gateway trusts `X-Forwarded-For` for rate limiting when
# `GATEWAY__TRUST_PROXY_HEADERS=true`, and that is only sound while this proxy
# is the sole path in. Publish the gateway port again and a caller can pick its
# own rate-limit bucket by setting the header itself.
#
# `SITE_DOMAIN` must be a real domain name. Let's Encrypt does not issue
# certificates for bare IP addresses, so the previous `http://193.70.42.29:5001`
# deployment cannot simply gain TLS — it needs a name pointed at that address.
# Set it in `.env` next to the compose file.

# The site: Angular frontend, with the gateway mounted under /v1 so the browser
# talks to one origin. Same-origin means the session cookie needs no CORS
# exception at all — `GATEWAY__CORS_ORIGIN` stays set for the desktop tooling
# and any other site, but the frontend itself stops depending on it.
{$SITE_DOMAIN} {
	encode zstd gzip

	# The gateway owns every versioned API path.
	handle /v1/* {
		reverse_proxy gateway:8081
	}

	# Everything else is the Angular app.
	handle {
		reverse_proxy frontend:80
	}

	header {
		# The game is not embeddable and never frames anything.
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# Two years, so browsers refuse plaintext for this name even if the
		# proxy is later misconfigured. Remove `preload` unless you actually
		# submit the domain — it is hard to undo.
		Strict-Transport-Security "max-age=63072000; includeSubDomains"

		# Tuned to what the Angular app actually loads:
		#
		# - `style-src` needs `unsafe-inline` because Angular injects component
		#   styles as inline <style> elements. There is no nonce to use without
		#   server-side rendering, so this is the floor for this stack.
		# - Google Fonts is linked from `apps/frontend/src/index.html`: the
		#   stylesheet comes from `fonts.googleapis.com` and the font files it
		#   references from `fonts.gstatic.com`.
		# - `connect-src 'self'` is enough because the browser talks only to
		#   `/v1` on this same origin. The desktop client, not the site, is what
		#   opens a socket to `stdb.` — do not widen this for it.
		# - `script-src` deliberately has no `unsafe-inline` or `unsafe-eval`.
		#   An AOT Angular build needs neither; if the app breaks on load, that
		#   is worth investigating rather than loosening.
		#
		# UNVERIFIED IN A BROWSER. If something fails to load, switch the
		# directive name to `Content-Security-Policy-Report-Only` to see the
		# violations without breaking the page, fix, then switch back.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}
}

# SpacetimeDB gets its own name rather than a path prefix on the main site: the
# SDK builds its own paths under the URI it is given (`/v1/database/<name>/...`),
# so a prefix here would need rewriting on every route the SDK knows about. A
# subdomain needs none, and the desktop client just points at
# `wss://stdb.<domain>`.
stdb.{$SITE_DOMAIN} {
	encode zstd gzip
	reverse_proxy spacetimedb:3000
}
